    ],
    "jedi.extraPaths": [
        "${workspaceFolder}/code/flink-sql/07-2-raw-to-multiple-types/python",
        "${workspaceFolder}/code/flink-sql/07-2-raw-to-multiple-types/python/producers",
        "${workspaceFolder}/code/flink-sql"
    ],
    "cursorpyright.analysis.exclude": [
